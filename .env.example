# Copy to .env and set a strong password:  openssl rand -base64 36 | tr -d '/+='
REDIS_PASSWORD=change-me

# Published ports on the host
HTTPS_PORT=443
HTTP_PORT=80

# Allowed link lifetimes in seconds (5 min, 1 h, 1 day, 3 days, 7 days)
TTL_OPTIONS=300,3600,86400,259200,604800
DEFAULT_TTL=86400

# Max secret/file size (bytes) and Redis memory cap
MAX_PLAINTEXT_BYTES=1048576
REDIS_MAXMEMORY=256mb
